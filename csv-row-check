import csv
import sys

reader = csv.reader(sys.stdin)
try:
    header = next(reader)
except StopIteration:
    print("CSVに項目名の行がありません", file=sys.stderr)
    sys.exit(1)

output = csv.writer(sys.stdout)

for row_number, row in enumerate(reader, start=2):
    for column_number, cell in enumerate(row[:len(header)], start=1):
        if not cell.strip():
            output.writerow([
                row_number,
                column_number,
                header[column_number - 1],
                "不足",
            ])

    for column_number in range(len(row) + 1, len(header) + 1):
        output.writerow([row_number, column_number, header[column_number - 1], "不足"])

    for column_number in range(len(header) + 1, len(row) + 1):
        output.writerow([row_number, column_number, "", "余分"])
